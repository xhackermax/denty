{
  "name": "denty-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/pipeline/run.mjs test",
    "test:watch": "vitest",
    "test:e2e": "node scripts/pipeline/run.mjs e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/pipeline/run.mjs verify",
    "ci": "node scripts/pipeline/run.mjs ci",
    "prepare": "node scripts/prepare-husky.mjs",
    "verify": "node scripts/pipeline/run.mjs verify",
    "architecture:check": "node scripts/verify-architecture.mjs",
    "deploy:check": "node scripts/verify-deployable-package.mjs",
    "domain:smoke": "node --experimental-strip-types scripts/verify-domain-smoke.ts",
    "test:domain:coverage": "node scripts/pipeline/run.mjs coverage",
    "history:check": "node scripts/verify-history-regressions.mjs",
    "preflight": "node scripts/pipeline/run.mjs preflight",
    "pipeline:self-check": "node scripts/pipeline/self-check.mjs",
    "api:parity": "node scripts/verify-api-parity.mjs",
    "vercel:regressions": "node scripts/verify-vercel-regression-matrix.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tabler/icons-react": "3.47.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-table": "9.2.4",
    "date-fns": "4.4.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "next-intl": "4.14.2",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.2": true,
    "unrs-resolver@1.12.2": true
  }
}
