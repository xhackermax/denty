{
  "name": "@denty/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:legacy": "node scripts/sync-legacy-assets.mjs",
    "dev": "pnpm sync:legacy && next dev -H 127.0.0.1 -p 8766",
    "build": "pnpm sync:legacy && next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude e2e/**",
    "test:e2e:parity": "playwright test e2e/parity"
  },
  "dependencies": {
    "@denty/domain": "workspace:*",
    "@denty/fixtures": "workspace:*",
    "@denty/ui": "workspace:*",
    "@denty/voice": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@playwright/test": "^1.55.0"
  }
}
