# ── Supabase (obligatorio) ─────────────────────────────────────────────
SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Alternativas legacy (solo si no usas las claves sb_publishable / sb_secret)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Estado de backups/PITR en Ajustes (opcional)
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_ACCESS_TOKEN=

# ── Voz / IA (docs/guias/IA-VOZ-NLU.md) ───────────────────────────────
# Vercel AI Gateway para Realtime Voice (gpt-realtime-2 o gpt-live-1)
AI_GATEWAY_API_KEY=
# Legacy: OpenAI direct (solo si no usas AI Gateway)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ── Datáfonos (docs/guias/DATAFONOS.md) ───────────────────────────────
# Stripe Terminal
STRIPE_SECRET_KEY=
STRIPE_DEFAULT_CONNECTED_ACCOUNT_ID=
# SumUp Cloud API (lector Solo)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_AFFILIATE_KEY=
SUMUP_APP_ID=
SUMUP_READER_ID=
SUMUP_RETURN_URL=

# ── VERI*FACTU (docs/guias/VERIFACTU.md) ──────────────────────────────
# Certificado de la empresa/autónomo que factura (PEM completo o ruta).
VERIFACTU_CERTIFICATE_PEM=
VERIFACTU_CERTIFICATE_PATH=

# ── Comunicaciones (Edge Function communication-outbox) ───────────────
DENTY_COMMUNICATION_PROVIDER_URL=
DENTY_COMMUNICATION_PROVIDER_TOKEN=
